#!/usr/bin/env python3
"""Manage per-team roadmap.json files and emit snapshots for the Herdr mod."""

from __future__ import annotations

import argparse
import contextlib
import copy
import datetime
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import uuid
from collections.abc import Callable, Iterator
from pathlib import Path

TEAM_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,16}$")
TASK_ID_RE = re.compile(r"^T-[1-9][0-9]*$")
MEMBER_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
VALID_STATUSES = ("open", "in-progress", "partial", "blocked", "done", "parked")
PRESET_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
TOP_KEYS = frozenset({"schema", "rev", "tasks"})
TASK_KEYS = frozenset(
    {"id", "title", "status", "phase", "prereqs", "brief", "created", "changed", "assignments", "queue", "log"}
)
ASSIGNMENT_KEYS = frozenset({"member", "from", "to"})
LOG_KEYS = frozenset({"at", "by", "change"})


class CliError(Exception):
    """Error raised for invalid CLI arguments or missing targets."""

    def __init__(self, message: str, code: int = 2) -> None:
        super().__init__(message)
        self.message = message
        self.code = code


class SchemaError(Exception):
    """Error raised on roadmap or team schema violation."""

    def __init__(self, message: str, filename: str = "roadmap.json") -> None:
        super().__init__(message)
        self.message = message
        self.filename = filename


def _empty_roadmap() -> dict:
    return {"schema": 1, "rev": 0, "tasks": []}


def _is_int(value: object) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def _parse_iso(value: object, path: str) -> datetime.datetime:
    if not isinstance(value, str) or not value:
        raise SchemaError(f"{path}: must be ISO 8601 timestamp string")
    try:
        parsed = datetime.datetime.fromisoformat(value)
    except ValueError as exc:
        raise SchemaError(f"{path}: invalid ISO 8601 timestamp ({exc})") from exc
    if parsed.tzinfo is None:
        raise SchemaError(f"{path}: timestamp must include UTC offset")
    return parsed


def validate_roadmap(roadmap: object) -> None:
    """Validate stored roadmap.json. Raises SchemaError('<path>: <reason>') on first violation.

    Rules:
        top level: dict with exactly schema, rev, tasks
        schema: 1 (int, not bool)
        rev: int >= 1 in a stored file
        tasks[i]: dict with exactly id, title, status, phase, prereqs, brief, created, changed, assignments, queue, log
        id: matches ^T-[1-9][0-9]*$, unique across tasks
        title: non-empty str, no newline
        status: one of open, in-progress, partial, blocked, done, parked
        phase: non-empty str or null
        prereqs: list of unique ids of tasks earlier in the list
        brief: str
        created, changed: ISO 8601 with UTC offset; changed >= created
        assignments[j]: dict with exactly member, from, to; member matches ^[a-z0-9][a-z0-9-]*$;
            from timestamp; to timestamp >= from or null
        assignments: from non-decreasing; at most one to: null, only on the last entry
        queue: preset name matching ^[a-z0-9][a-z0-9-]*$ or null
        log: non-empty list of {at, by, change}; at non-decreasing; by matches the member regex;
            change a non-empty str with no newline
    """
    if not isinstance(roadmap, dict) or set(roadmap.keys()) != TOP_KEYS:
        raise SchemaError("top level: must be dict with exactly schema, rev, tasks")
    if not _is_int(roadmap["schema"]) or roadmap["schema"] != 1:
        raise SchemaError("schema: must be 1")
    if not _is_int(roadmap["rev"]) or roadmap["rev"] < 1:
        raise SchemaError("rev: must be int >= 1")
    tasks = roadmap["tasks"]
    if not isinstance(tasks, list):
        raise SchemaError("tasks: must be a list")

    earlier_ids: set[str] = set()
    for idx, task in enumerate(tasks):
        tp = f"tasks[{idx}]"
        if not isinstance(task, dict) or set(task.keys()) != TASK_KEYS:
            raise SchemaError(f"{tp}: must be dict with exact task keys")
        task_id = task["id"]
        if not isinstance(task_id, str) or not TASK_ID_RE.match(task_id):
            raise SchemaError(f"{tp}.id: must match ^T-[1-9][0-9]*$")
        if task_id in earlier_ids:
            raise SchemaError(f"{tp}.id: duplicate id {task_id}")

        title = task["title"]
        if not isinstance(title, str) or not title.strip() or "\n" in title or "\r" in title:
            raise SchemaError(f"{tp}.title: must be non-empty str with no newline")
        if task["status"] not in VALID_STATUSES:
            raise SchemaError(f"{tp}.status: invalid status {task['status']!r}")
        phase = task["phase"]
        if phase is not None and (not isinstance(phase, str) or not phase.strip()):
            raise SchemaError(f"{tp}.phase: must be non-empty str or null")

        prereqs = task["prereqs"]
        if not isinstance(prereqs, list):
            raise SchemaError(f"{tp}.prereqs: must be a list")
        seen_prereqs: set[str] = set()
        for p_idx, prereq in enumerate(prereqs):
            if not isinstance(prereq, str) or prereq not in earlier_ids:
                raise SchemaError(f"{tp}.prereqs[{p_idx}]: must reference an earlier task id")
            if prereq in seen_prereqs:
                raise SchemaError(f"{tp}.prereqs[{p_idx}]: duplicate prereq {prereq}")
            seen_prereqs.add(prereq)

        if not isinstance(task["brief"], str):
            raise SchemaError(f"{tp}.brief: must be str")
        created_dt = _parse_iso(task["created"], f"{tp}.created")
        changed_dt = _parse_iso(task["changed"], f"{tp}.changed")
        if changed_dt < created_dt:
            raise SchemaError(f"{tp}.changed: must be >= created")

        assignments = task["assignments"]
        if not isinstance(assignments, list):
            raise SchemaError(f"{tp}.assignments: must be a list")
        prev_from: datetime.datetime | None = None
        for j, entry in enumerate(assignments):
            ap = f"{tp}.assignments[{j}]"
            if not isinstance(entry, dict) or set(entry.keys()) != ASSIGNMENT_KEYS:
                raise SchemaError(f"{ap}: must be dict with exactly member, from, to")
            if not isinstance(entry["member"], str) or not MEMBER_RE.match(entry["member"]):
                raise SchemaError(f"{ap}.member: must match ^[a-z0-9][a-z0-9-]*$")
            from_dt = _parse_iso(entry["from"], f"{ap}.from")
            if prev_from is not None and from_dt < prev_from:
                raise SchemaError(f"{ap}.from: must be non-decreasing")
            prev_from = from_dt
            if entry["to"] is None:
                if j != len(assignments) - 1:
                    raise SchemaError(f"{ap}.to: null only allowed on last assignment")
            else:
                to_dt = _parse_iso(entry["to"], f"{ap}.to")
                if to_dt < from_dt:
                    raise SchemaError(f"{ap}.to: must be >= from")

        queue = task["queue"]
        if queue is not None and (not isinstance(queue, str) or not PRESET_RE.match(queue)):
            raise SchemaError(f"{tp}.queue: must match ^[a-z0-9][a-z0-9-]*$ or null")

        log = task["log"]
        if not isinstance(log, list) or not log:
            raise SchemaError(f"{tp}.log: must be a non-empty list")
        prev_at: datetime.datetime | None = None
        for j, entry in enumerate(log):
            lp = f"{tp}.log[{j}]"
            if not isinstance(entry, dict) or set(entry.keys()) != LOG_KEYS:
                raise SchemaError(f"{lp}: must be dict with exactly at, by, change")
            at_dt = _parse_iso(entry["at"], f"{lp}.at")
            if prev_at is not None and at_dt < prev_at:
                raise SchemaError(f"{lp}.at: must be non-decreasing")
            prev_at = at_dt
            if not isinstance(entry["by"], str) or not MEMBER_RE.match(entry["by"]):
                raise SchemaError(f"{lp}.by: must match ^[a-z0-9][a-z0-9-]*$")
            change = entry["change"]
            if not isinstance(change, str) or not change.strip() or "\n" in change or "\r" in change:
                raise SchemaError(f"{lp}.change: must be non-empty str with no newline")
        earlier_ids.add(task_id)


def validate_team(team: object, expected_team: str | None = None) -> None:
    """Validate team.json subset. Raises SchemaError('<path>: <reason>')."""
    if not isinstance(team, dict):
        raise SchemaError("top level: must be dict", filename="team.json")
    if not isinstance(team.get("team"), str) or not team["team"]:
        raise SchemaError("team: must be non-empty str", filename="team.json")
    if expected_team is not None and team["team"] != expected_team:
        raise SchemaError(f"team: expected {expected_team!r}, got {team['team']!r}", filename="team.json")
    lead = team.get("lead")
    if not isinstance(lead, dict) or not isinstance(lead.get("name"), str) or not lead["name"]:
        raise SchemaError("lead.name: must be non-empty str", filename="team.json")
    if not isinstance(lead.get("preset"), str) or not lead["preset"]:
        raise SchemaError("lead.preset: must be non-empty str", filename="team.json")
    team_members = team.get("members")
    if not isinstance(team_members, list):
        raise SchemaError("members: must be a list", filename="team.json")
    for idx, member in enumerate(team_members):
        if not isinstance(member, dict) or not isinstance(member.get("name"), str) or not member["name"]:
            raise SchemaError(f"members[{idx}].name: must be non-empty str", filename="team.json")
        if not isinstance(member.get("preset"), str) or not member["preset"]:
            raise SchemaError(f"members[{idx}].preset: must be non-empty str", filename="team.json")


def _team_dir(team: str) -> Path:
    if not TEAM_RE.match(team):
        raise CliError(f"invalid team name {team!r}: must match {TEAM_RE.pattern}")
    home = os.environ.get("TEAM_ROADMAP_HOME")
    base = Path(home) if home else Path.home() / ".claude/teams"
    return base / team


def _read_team_json(team_dir: Path) -> tuple[bytes, dict]:
    team_path = team_dir / "team.json"
    if not team_path.is_file():
        raise CliError(f"missing team.json at {team_path}", code=1)
    try:
        raw = team_path.read_bytes()
        data = json.loads(raw.decode("utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise CliError(f"cannot read team.json at {team_path}: {exc}", code=1) from exc
    validate_team(data, expected_team=team_dir.name)
    return raw, data


def load(team_dir: Path) -> dict:
    """Return validated roadmap.json, or the empty default when absent."""
    roadmap_path = team_dir / "roadmap.json"
    if not roadmap_path.exists():
        return _empty_roadmap()
    try:
        data = json.loads(roadmap_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise SchemaError(f"cannot parse JSON ({exc})") from exc
    validate_roadmap(data)
    return data


def save(team_dir: Path, roadmap: dict) -> None:
    """Increment rev, validate schema, write .tmp, and os.replace. Caller holds the lock."""
    roadmap["rev"] += 1
    validate_roadmap(roadmap)
    tmp_path = team_dir / "roadmap.json.tmp"
    target_path = team_dir / "roadmap.json"
    tmp_path.write_text(json.dumps(roadmap, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp_path, target_path)


@contextlib.contextmanager
def locked(team_dir: Path) -> Iterator[None]:
    """Acquire an exclusive fcntl.flock on <team_dir>/roadmap.lock."""
    lock_path = team_dir / "roadmap.lock"
    with lock_path.open("a+", encoding="utf-8") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)


def members(team_data: dict) -> list[str]:
    """Member names, lead first, then members[] in team.json order."""
    return [team_data["lead"]["name"], *(entry["name"] for entry in team_data["members"])]


def resolve_member(team: str, name: str, known: list[str]) -> str:
    """Resolve short or full member name to full name; raise CliError(2) if unknown."""
    if name in known:
        return name
    prefixed = f"{team}-{name}"
    if prefixed in known:
        return prefixed
    raise CliError(f"unknown member {name} (members: {', '.join(known)})")


def actor() -> str:
    """Who runs this command: $AGENT_NAME (every hc launch sets it), or 'sam' when it's unset (Sam's own shell)."""
    name = os.environ.get("AGENT_NAME", "").strip()
    return name or "sam"


def _short_member(team: str, name: str) -> str:
    return name.removeprefix(f"{team}-")


def now() -> str:
    """Return local time as ISO 8601 with offset and seconds precision."""
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def snapshot(team_dir: Path, since: str | None) -> dict:
    """Return {"token", "team", "roadmap"}, or {"unchanged": True} when since equals the current token.

    token is "<rev>:<first 12 hex of sha1(team.json bytes)>", so it changes when a task changes or a member is
    added. Reads without the lock: the CLI replaces both files atomically.
    """
    team_bytes, team_data = _read_team_json(team_dir)
    roadmap = load(team_dir)
    team_hash = hashlib.sha1(team_bytes).hexdigest()[:12]
    token = f"{roadmap['rev']}:{team_hash}"
    if since is not None and since == token:
        return {"unchanged": True}
    return {"token": token, "team": team_data, "roadmap": roadmap}


def _read_brief(brief_file: str | None) -> str:
    if brief_file is None:
        return ""
    if brief_file == "-":
        return sys.stdin.read()
    try:
        return Path(brief_file).read_text(encoding="utf-8")
    except OSError as exc:
        raise CliError(f"cannot read brief file {brief_file}: {exc}") from exc


def _find_task(roadmap: dict, task_id: str) -> dict:
    for task in roadmap["tasks"]:
        if task["id"] == task_id:
            return task
    raise CliError(f"unknown task id {task_id}")


def require(allowed: bool, who: str, what: str, rule: str) -> None:
    """Raise CliError(code=3) unless allowed."""
    if not allowed:
        raise CliError(f"team-roadmap: {who} can't {what}: {rule}", code=3)


def _is_lead(team_data: dict, who: str) -> bool:
    return who == "sam" or who == team_data["lead"]["name"]


def _member_preset(team_data: dict, who: str) -> str | None:
    for entry in team_data["members"]:
        if entry["name"] == who:
            return entry["preset"]
    return None


def _member_presets(team_data: dict) -> set[str]:
    return {entry["preset"] for entry in team_data["members"]}


def _active_assignment(task: dict) -> dict | None:
    assignments = task["assignments"]
    return assignments[-1] if assignments and assignments[-1]["to"] is None else None


def _pause_other_tasks(roadmap: dict, team: str, member: str, keep_id: str, who: str, ts: str) -> list[str]:
    """Set every other in-progress task whose open assignee is `member` to partial; returns their ids."""
    short = _short_member(team, member)
    paused: list[str] = []
    for other in roadmap["tasks"]:
        if other["id"] == keep_id or other["status"] != "in-progress":
            continue
        active = _active_assignment(other)
        if active is not None and active["member"] == member:
            other["status"] = "partial"
            other["changed"] = ts
            other["log"].append(
                {"at": ts, "by": who, "change": f"status in-progress → partial ({short} started {keep_id})"}
            )
            paused.append(other["id"])
    return paused


def cmd_add(args: argparse.Namespace) -> None:
    """Handle the 'add' subcommand."""
    team_dir = _team_dir(args.team)
    _, team_data = _read_team_json(team_dir)
    who = actor()
    require(_is_lead(team_data, who), who, "add tasks", "only the lead can add tasks")
    known = members(team_data)
    if args.status not in VALID_STATUSES:
        raise CliError(f"invalid status {args.status!r} (valid: {', '.join(VALID_STATUSES)})")
    if not args.title.strip() or "\n" in args.title or "\r" in args.title:
        raise CliError("title must be non-empty with no newline")
    assignee = resolve_member(args.team, args.assign, known) if args.assign else None
    queue_preset = args.queue
    if queue_preset is not None and queue_preset not in _member_presets(team_data):
        raise CliError(f"unknown preset {queue_preset!r} (presets: {', '.join(sorted(_member_presets(team_data)))})")
    brief = _read_brief(args.brief_file)
    phase = args.phase.strip() if args.phase is not None and args.phase.strip() else None
    prereqs = args.prereq or []

    with locked(team_dir):
        roadmap = load(team_dir)
        existing_ids = {t["id"] for t in roadmap["tasks"]}
        for prereq in prereqs:
            if prereq not in existing_ids:
                raise CliError(f"unknown prereq {prereq}")
        max_n = max((int(t["id"].split("-")[1]) for t in roadmap["tasks"]), default=0)
        task_id = f"T-{max_n + 1}"
        ts = now()
        who = actor()
        assignments = [{"member": assignee, "from": ts, "to": None}] if assignee else []
        roadmap["tasks"].append(
            {
                "id": task_id,
                "title": args.title,
                "status": args.status,
                "phase": phase,
                "prereqs": list(prereqs),
                "brief": brief,
                "created": ts,
                "changed": ts,
                "assignments": assignments,
                "queue": queue_preset,
                "log": [{"at": ts, "by": who, "change": "added"}],
            }
        )
        paused = (
            _pause_other_tasks(roadmap, args.team, assignee, task_id, who, ts)
            if args.status == "in-progress" and assignee
            else []
        )
        save(team_dir, roadmap)
    for pid in paused:
        print(f"paused {pid}", file=sys.stderr)
    print(task_id)


def cmd_set_status(args: argparse.Namespace) -> None:
    """Handle the 'set-status' subcommand."""
    team_dir = _team_dir(args.team)
    _, team_data = _read_team_json(team_dir)
    who = actor()
    if args.status not in VALID_STATUSES:
        raise CliError(f"invalid status {args.status!r} (valid: {', '.join(VALID_STATUSES)})")
    with locked(team_dir):
        roadmap = load(team_dir)
        task = _find_task(roadmap, args.id)
        active = _active_assignment(task)
        if args.status == "done" or task["status"] == "done":
            require(
                _is_lead(team_data, who),
                who,
                f"set {args.id} to {args.status}",
                "only the lead moves tasks into or out of done",
            )
        else:
            active_member = active["member"] if active is not None else None
            require(
                _is_lead(team_data, who) or who == active_member,
                who,
                f"set {args.id} to {args.status}",
                "only the lead or the assignee can change status",
            )
        old_status = task["status"]
        if old_status == args.status:
            return
        ts = now()
        task["status"] = args.status
        task["changed"] = ts
        task["log"].append({"at": ts, "by": who, "change": f"status {old_status} → {args.status}"})
        paused = (
            _pause_other_tasks(roadmap, args.team, active["member"], args.id, who, ts)
            if args.status == "in-progress" and active is not None
            else []
        )
        save(team_dir, roadmap)
    for pid in paused:
        print(f"paused {pid}", file=sys.stderr)


def cmd_assign(args: argparse.Namespace) -> None:
    """Handle the 'assign' subcommand."""
    team_dir = _team_dir(args.team)
    _, team_data = _read_team_json(team_dir)
    who = actor()
    require(_is_lead(team_data, who), who, f"assign {args.id}", "only the lead can assign tasks")
    known = members(team_data)
    target = None if args.member == "none" else resolve_member(args.team, args.member, known)
    with locked(team_dir):
        roadmap = load(team_dir)
        task = _find_task(roadmap, args.id)
        assignments = task["assignments"]
        active = _active_assignment(task)
        if target is None:
            if active is None:
                return
            ts = now()
            old_short = _short_member(args.team, active["member"])
            active["to"] = ts
            task["changed"] = ts
            task["log"].append({"at": ts, "by": actor(), "change": f"unassigned {old_short}"})
            save(team_dir, roadmap)
            return
        if active is not None and active["member"] == target:
            return
        ts = now()
        if active is not None:
            active["to"] = ts
        assignments.append({"member": target, "from": ts, "to": None})
        task["changed"] = ts
        task["log"].append({"at": ts, "by": actor(), "change": f"assigned {_short_member(args.team, target)}"})
        paused = (
            _pause_other_tasks(roadmap, args.team, target, args.id, who, ts) if task["status"] == "in-progress" else []
        )
        save(team_dir, roadmap)
    for pid in paused:
        print(f"paused {pid}", file=sys.stderr)


def cmd_set_brief(args: argparse.Namespace) -> None:
    """Handle the 'set-brief' subcommand."""
    team_dir = _team_dir(args.team)
    _, team_data = _read_team_json(team_dir)
    who = actor()
    require(_is_lead(team_data, who), who, f"edit {args.id} brief", "only the lead can edit briefs")
    brief = _read_brief(args.brief_file)
    with locked(team_dir):
        roadmap = load(team_dir)
        task = _find_task(roadmap, args.id)
        if task["brief"] == brief:
            return
        ts = now()
        task["brief"] = brief
        task["changed"] = ts
        task["log"].append({"at": ts, "by": who, "change": "brief changed"})
        save(team_dir, roadmap)


def cmd_queue(args: argparse.Namespace) -> None:
    """Handle the 'queue' subcommand."""
    team_dir = _team_dir(args.team)
    _, team_data = _read_team_json(team_dir)
    who = actor()
    require(_is_lead(team_data, who), who, f"queue {args.id}", "only the lead can queue tasks")
    target = None if args.preset == "none" else args.preset
    if target is not None and target not in _member_presets(team_data):
        raise CliError(f"unknown preset {target!r} (presets: {', '.join(sorted(_member_presets(team_data)))})")
    with locked(team_dir):
        roadmap = load(team_dir)
        task = _find_task(roadmap, args.id)
        if task["queue"] == target:
            return
        ts = now()
        task["queue"] = target
        task["changed"] = ts
        change = "unqueued" if target is None else f"queued for {target}"
        task["log"].append({"at": ts, "by": who, "change": change})
        save(team_dir, roadmap)


def _claim_block_reason(team: str, task: dict, done_ids: set[str]) -> str | None:
    active = _active_assignment(task)
    if active is not None:
        return f"{task['id']} is assigned to {_short_member(team, active['member'])}"
    if task["status"] not in ("open", "partial"):
        return f"{task['id']} is {task['status']}"
    for prereq in task["prereqs"]:
        if prereq not in done_ids:
            return f"{task['id']} waits for {prereq}"
    return None


def cmd_claim(args: argparse.Namespace) -> None:
    """Handle the 'claim' subcommand."""
    team_dir = _team_dir(args.team)
    _, team_data = _read_team_json(team_dir)
    who = actor()
    caller_preset = _member_preset(team_data, who)
    require(
        caller_preset is not None,
        who,
        f"claim {args.id or 'a task'}",
        "only team members can claim queued tasks",
    )
    with locked(team_dir):
        roadmap = load(team_dir)
        done_ids = {t["id"] for t in roadmap["tasks"] if t["status"] == "done"}
        if args.id is not None:
            task = _find_task(roadmap, args.id)
            require(
                task["queue"] == caller_preset,
                who,
                f"claim {args.id}",
                f"task is in {task['queue'] or 'no'} queue, not {caller_preset}",
            )
            reason = _claim_block_reason(args.team, task, done_ids)
            if reason is not None:
                raise CliError(reason)
        else:
            task = next(
                (
                    t
                    for t in roadmap["tasks"]
                    if t["queue"] == caller_preset and _claim_block_reason(args.team, t, done_ids) is None
                ),
                None,
            )
            if task is None:
                raise CliError(f"nothing to claim in the {caller_preset} queue", code=4)
        ts = now()
        task["assignments"].append({"member": who, "from": ts, "to": None})
        task["status"] = "in-progress"
        task["changed"] = ts
        task["log"].append({"at": ts, "by": who, "change": f"claimed from the {caller_preset} queue"})
        paused = _pause_other_tasks(roadmap, args.team, who, task["id"], who, ts)
        save(team_dir, roadmap)
    for pid in paused:
        print(f"paused {pid}", file=sys.stderr)
    print(task["id"])


def cmd_snapshot(args: argparse.Namespace) -> None:
    """Handle the 'snapshot' subcommand."""
    team_dir = _team_dir(args.team)
    payload = snapshot(team_dir, args.since)
    print(json.dumps(payload))


def _has_roadmap_block(node: dict) -> bool:
    content = node.get("content")
    if isinstance(content, dict) and content.get("mod") == "team-roadmap":
        return True
    return any(_has_roadmap_block(child) for child in node.get("children", []) if isinstance(child, dict))


def with_roadmap_tab(doc: dict, team: str, machine: str | None) -> dict | None:
    """Return doc with a Roadmap tab appended to space <team>, or None if the space already has one.

    Raises CliError(1) when the space doesn't exist. Pure: no I/O, so tests feed it a doc dict.
    """
    updated = copy.deepcopy(doc)
    space = next((s for s in updated.get("spaces", []) if s.get("id") == team), None)
    if space is None:
        raise CliError(f"unknown space {team!r}", code=1)
    tabs = space.setdefault("tabs", [])
    if any(_has_roadmap_block(tab["root"]) for tab in tabs if isinstance(tab.get("root"), dict)):
        return None
    tid = f"tb{uuid.uuid4().hex}"
    tabs.append(
        {
            "id": tid,
            "name": "Roadmap",
            "root": {
                "type": "row",
                "id": tid,
                "children": [
                    {
                        "type": "block",
                        "id": f"p{uuid.uuid4().hex}",
                        "content": {"mod": "team-roadmap", "props": {"team": team, "machine": machine}},
                    }
                ],
            },
        }
    )
    return updated


def _rpc(method: str, params: dict) -> dict:
    """One JSON-RPC call via `hc connect`, adapted from space-layout.py's rpc().

    Raises CliError(1) when hc can't be run or replies garbage, RuntimeError on an error reply (doc.set's version
    conflict, which the caller retries).
    """
    hc = shutil.which("hc") or os.path.expanduser("~/.local/bin/hc")
    request = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}) + "\n"
    try:
        out = subprocess.run([hc, "connect"], input=request, capture_output=True, text=True, timeout=10, check=True)
        reply = json.loads(out.stdout.splitlines()[0])
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError, IndexError) as exc:
        raise CliError(f"open-tab: {method} failed ({exc})", code=1) from exc
    if "error" in reply:
        raise RuntimeError(f"{method}: {reply['error']}")
    return reply["result"]


def _edit_app_doc(edit: Callable[[dict], dict | None], what: str) -> None:
    """Apply `edit` to the app's layout doc with compare-and-set, retrying version conflicts up to 5 times.

    `edit` returns the new doc, or None when there is nothing to change. Raises CliError(1) naming `what`.
    """
    for _ in range(5):
        try:
            doc = _rpc("doc.get", {"name": "herdr-app"})
        except RuntimeError as exc:
            raise CliError(f"{what}: {exc}", code=1) from exc
        updated = edit(doc["value"])
        if updated is None:
            return
        try:
            _rpc("doc.set", {"name": "herdr-app", "value": updated, "version": doc["version"]})
            return
        except RuntimeError:
            continue
    raise CliError(f"{what}: doc.set kept failing", code=1)


def cmd_open_tab(args: argparse.Namespace) -> None:
    """Handle the 'open-tab' subcommand."""
    if not TEAM_RE.match(args.team):
        raise CliError(f"invalid team name {args.team!r}: must match {TEAM_RE.pattern}")
    # The Mac app knows mrc as "mrct"; on the Mac itself the store is local (machine=None).
    machine = None if sys.platform == "darwin" else "mrct"
    _edit_app_doc(lambda doc: with_roadmap_tab(doc, args.team, machine), "open-tab")


def without_roadmap_tab(doc: dict, team: str) -> dict | None:
    """Return doc with space <team>'s team-roadmap tabs removed, and the space too if no tab is left.

    None when the space or the tab is absent (nothing to do). Pure, like with_roadmap_tab.
    """
    updated = copy.deepcopy(doc)
    spaces = updated.get("spaces", [])
    space_idx = next((i for i, s in enumerate(spaces) if s.get("id") == team), None)
    if space_idx is None:
        return None
    tabs = spaces[space_idx].get("tabs", [])
    kept = [tab for tab in tabs if not (isinstance(tab.get("root"), dict) and _has_roadmap_block(tab["root"]))]
    if len(kept) == len(tabs):
        return None
    if kept:
        spaces[space_idx]["tabs"] = kept
    else:
        del spaces[space_idx]
    return updated


def cmd_close_tab(args: argparse.Namespace) -> None:
    """Handle the 'close-tab' subcommand."""
    if not TEAM_RE.match(args.team):
        raise CliError(f"invalid team name {args.team!r}: must match {TEAM_RE.pattern}")
    _edit_app_doc(lambda doc: without_roadmap_tab(doc, args.team), "close-tab")


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="team-roadmap", description="Manage per-team roadmap tasks.")
    sub = parser.add_subparsers(dest="command", required=True)

    p_add = sub.add_parser("add", help="Add a task to the team roadmap.")
    p_add.add_argument("team")
    p_add.add_argument("--title", required=True)
    p_add.add_argument("--brief-file", default=None)
    p_add.add_argument("--phase", default=None)
    p_add.add_argument("--prereq", nargs="+", action="extend", default=[])
    p_add.add_argument("--assign", default=None)
    p_add.add_argument("--status", default="open")
    p_add.add_argument("--queue", default=None)
    p_add.set_defaults(func=cmd_add)

    p_status = sub.add_parser("set-status", help="Update a task's status.")
    p_status.add_argument("team")
    p_status.add_argument("id")
    p_status.add_argument("status")
    p_status.set_defaults(func=cmd_set_status)

    p_assign = sub.add_parser("assign", help="Assign or unassign a task.")
    p_assign.add_argument("team")
    p_assign.add_argument("id")
    p_assign.add_argument("member")
    p_assign.set_defaults(func=cmd_assign)

    p_brief = sub.add_parser("set-brief", help="Update a task's markdown brief.")
    p_brief.add_argument("team")
    p_brief.add_argument("id")
    p_brief.add_argument("--brief-file", required=True)
    p_brief.set_defaults(func=cmd_set_brief)

    p_queue = sub.add_parser("queue", help="Assign or clear a task's role queue.")
    p_queue.add_argument("team")
    p_queue.add_argument("id")
    p_queue.add_argument("preset")
    p_queue.set_defaults(func=cmd_queue)

    p_claim = sub.add_parser("claim", help="Claim a queued task for the calling member.")
    p_claim.add_argument("team")
    p_claim.add_argument("id", nargs="?", default=None)
    p_claim.set_defaults(func=cmd_claim)

    p_snap = sub.add_parser("snapshot", help="Print a JSON snapshot for the mod.")
    p_snap.add_argument("team")
    p_snap.add_argument("--since", default=None)
    p_snap.set_defaults(func=cmd_snapshot)

    p_open = sub.add_parser("open-tab", help="Append a Roadmap tab to the team's Herdr space.")
    p_open.add_argument("team")
    p_open.set_defaults(func=cmd_open_tab)

    p_close = sub.add_parser("close-tab", help="Remove the Roadmap tab from the team's Herdr space.")
    p_close.add_argument("team")
    p_close.set_defaults(func=cmd_close_tab)

    return parser


def main(argv: list[str] | None = None) -> int:
    """CLI entry point."""
    parser = _build_parser()
    args = parser.parse_args(argv)
    try:
        args.func(args)
    except SchemaError as exc:
        print(f"{exc.filename}: {exc.message}", file=sys.stderr)
        return 1
    except CliError as exc:
        print(exc.message, file=sys.stderr)
        return exc.code
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
